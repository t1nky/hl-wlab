{
  "name": "hl-wlab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --bun vite --config web/vite.config.ts",
    "build": "bun run typecheck && bun --bun vite build --config web/vite.config.ts",
    "start": "bun tools/serve-web.mjs",
    "preview": "bun tools/serve-web.mjs",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "bun --bun vitest run --config web/vite.config.ts",
    "test:watch": "bun --bun vitest --config web/vite.config.ts",
    "check": "bun run lint && bun run test && bun run build",
    "check:repo": "bun tools/check-repo.mjs",
    "check:pages": "bun tools/check-pages.mjs",
    "cs2:prepare": "bun tools/cs2-prepare.mjs",
    "cs2:prepare:render": "bun tools/cs2-prepare.mjs --render",
    "cs2:prepare:player": "bun tools/cs2-prepare.mjs --player",
    "cs2:dev": "bun --bun vite --config web/cs2/vite.config.ts",
    "cs2:check": "tsc --noEmit -p web/cs2/tsconfig.json && bun --bun vite build --config web/cs2/vite.config.ts",
    "cs2:test:importer": "dotnet run --project tools/cs2-import-tests/Tests.csproj",
    "cs2:smoke": "bun tools/cs2-smoke.mjs",
    "cs2:smoke:scan": "bun tools/cs2-scan-smoke.mjs"
  },
  "dependencies": {
    "three": "0.170.0",
    "three-mesh-bvh": "0.9.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/three": "0.170.0",
    "fake-indexeddb": "6.2.6",
    "meshoptimizer": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
